{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(.coder-ai/scripts/update-ai-context.sh:*)",
      "Bash(.coder-ai/val/run:*)",
      "Bash(coder-ai pr:*)",
      "Bash(coder-ai prove:*)",
      "Bash(coder-ai ship:*)",
      "Bash(coder-ai-os pr:*)",
      "Bash(coder-ai val:*)",
      "Bash(coder-ai-os val:*)",
      "Bash(codex exec --cd * --sandbox read-only:*)",
      "Bash(codex exec --cd * --sandbox workspace-write:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Glob",
      "Grep",
      "Read"
    ],
    "deny": [
      "Bash(codex exec *--dangerously-bypass-approvals-and-sandbox*:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(sudo:*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/service-account.json)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  },
  "skipAutoPermissionPrompt": true
}
