#!/usr/bin/env python3
"""Agent Compiler — one source of truth (config/*.yaml) -> per-tool instruction files.

AGENTS.md is the canonical output (emerging cross-tool standard); CLAUDE.md and
GEMINI.md are adapters over the same compiled body with a tool-specific footer.
Guardrails (config/safety.yaml `never`) compile to the TOP of every file, because
negative constraints improve agent reliability more than positive checklists.

Zero hard dependency: uses PyYAML when importable, else a vendored stdlib-only parser
for the small YAML subset our config uses (2-space maps, `- ` scalar lists, quoted
scalars, booleans/ints). Budgets in config/tokens.yaml are enforced by `--check`.

Usage:
  bin/compile            compile config/ -> build/{AGENTS,CLAUDE,GEMINI}.md
  bin/compile --check    compile to memory, report sizes/budget/drift, exit 1 if over
"""
import sys, os, json, re, shutil, tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CONFIG_DIR = os.path.join(ROOT, "config")
BUILD_DIR = os.path.join(ROOT, "build")
# Stamp on every generated command/skill/agent file so install never overwrites a user's
# own same-named file (only files carrying this marker are treated as ours and updated).
GEN_MD = "<!-- coder-ai-os:generated -->"

# (output filename, tool key, scope). "global" files are injected into ~ by install.sh;
# "project" files are repo-scoped and written into a target repo by install.sh --project.
TOOLS = [
    ("AGENTS.md", "codex", "global"),   # canonical
    ("CLAUDE.md", "claude", "global"),
    ("GEMINI.md", "gemini", "global"),
    ("cursor.mdc", "cursor", "project"),
    ("copilot-instructions.md", "copilot", "project"),
]


# ---- YAML loading: PyYAML if present, else a vendored subset parser ----------
def _coerce(s):
    s = s.strip()
    if len(s) >= 2 and s[0] in "\"'" and s[-1] == s[0]:
        return s[1:-1]
    if len(s) >= 2 and s[0] == "[" and s[-1] == "]":  # inline flow list: [a, b]
        inner = s[1:-1].strip()
        return [_coerce(x) for x in inner.split(",")] if inner else []
    low = s.lower()
    if low in ("true", "yes"):
        return True
    if low in ("false", "no"):
        return False
    if low in ("null", "~", ""):
        return None
    for cast in (int, float):
        try:
            return cast(s)
        except ValueError:
            pass
    return s


def _next_content_indent(lines, i):
    while i < len(lines):
        st = lines[i].strip()
        if st and not st.startswith("#"):
            return len(lines[i]) - len(lines[i].lstrip(" "))
        i += 1
    return -1


def _parse(lines, i, indent):
    node = None
    while i < len(lines):
        raw = lines[i]
        st = raw.strip()
        if not st or st.startswith("#"):
            i += 1
            continue
        cur = len(raw) - len(raw.lstrip(" "))
        if cur < indent:
            break
        if cur > indent:  # defensive; well-formed config won't hit this
            break
        if st.startswith("- "):
            if node is None:
                node = []
            node.append(_coerce(st[2:]))
            i += 1
        else:
            if node is None:
                node = {}
            if ": " in st:
                key, val = st.split(": ", 1)
                # CI parity: strict YAML (PyYAML) rejects an unquoted plain scalar
                # containing ": ". Fail here too, so a machine without PyYAML catches
                # the error locally instead of first seeing it in CI.
                plain = val.strip().split(" #", 1)[0].rstrip()
                if plain and plain[0] not in "\"'" and ": " in plain:
                    raise SystemExit("invalid YAML — unquoted ': ' inside a value "
                                     "(quote the string or reword): " + st)
                node[key.strip()] = _coerce(val)
                i += 1
            elif st.endswith(":"):
                key = st[:-1].strip()
                i += 1
                child_indent = _next_content_indent(lines, i)
                if child_indent > indent:
                    child, i = _parse(lines, i, child_indent)
                    node[key] = child if child is not None else {}
                else:
                    node[key] = {}
            else:
                i += 1  # skip malformed line
    return node, i


def load_yaml(path):
    with open(path, "r", encoding="utf-8") as f:
        text = f.read()
    try:
        import yaml  # PyYAML, if available
        return yaml.safe_load(text) or {}
    except ImportError:
        node, _ = _parse(text.splitlines(), 0, 0)
        return node or {}


def deep_merge(base, over):
    """Recursively merge `over` into `base` (dicts). Scalars/lists in `over` win."""
    for k, v in (over or {}).items():
        if isinstance(v, dict) and isinstance(base.get(k), dict):
            deep_merge(base[k], v)
        else:
            base[k] = v
    return base


STEMS = ("identity", "safety", "workflow", "tokens", "user",
         "context", "skills", "commands", "subagents", "hooks", "mcp", "memory",
         "pr_automation")


def _apply_overlay(cfg, path):
    """Deep-merge an overlay file's stems over cfg; safety is never overridable."""
    if not path or not os.path.exists(path):
        return
    over_all = load_yaml(path) or {}
    # safety and pr_automation are boundaries, not preferences: never overridable.
    over_all.pop("safety", None)
    over_all.pop("pr_automation", None)
    for stem, over in over_all.items():
        if stem in cfg and isinstance(cfg[stem], dict) and isinstance(over, dict):
            deep_merge(cfg[stem], over)


def load_config(repo_overlay=None, use_machine_overlay=True):
    # Precedence (low → high): defaults < language preset < machine overlay < repo overlay.
    # use_machine_overlay=False ignores config/local.yaml — used to render the COMMITTED,
    # shared build/ (defaults-only), so per-machine prefs never leak into the artifact.
    cfg = {}
    for stem in STEMS:
        p = os.path.join(CONFIG_DIR, stem + ".yaml")
        cfg[stem] = load_yaml(p) if os.path.exists(p) else {}

    local_path = os.path.join(CONFIG_DIR, "local.yaml")
    local = (load_yaml(local_path) or {}) if (use_machine_overlay and os.path.exists(local_path)) else {}
    local.pop("safety", None)  # guardrails are non-negotiable

    # Repo overlay (highest precedence) — <repo>/.coder-ai/project.yaml, when compiling a repo.
    repo = {}
    if repo_overlay and os.path.exists(repo_overlay):
        repo = load_yaml(repo_overlay) or {}
        repo.pop("safety", None)

    # Language presets: for every language declared anywhere (repo wins, then local, then base).
    langs = (repo.get("user", {}) or {}).get("languages") \
        or (local.get("user", {}) or {}).get("languages") \
        or (cfg["user"].get("languages") or [])
    for lang in langs if isinstance(langs, list) else []:
        _apply_overlay(cfg, os.path.join(CONFIG_DIR, "profiles", str(lang).lower() + ".yaml"))

    # Overlays low → high: machine (local.yaml), then repo (.coder-ai/project.yaml).
    for src in (local, repo):
        for stem, over in src.items():
            if stem in cfg and isinstance(cfg[stem], dict) and isinstance(over, dict):
                deep_merge(cfg[stem], over)
    return cfg


# ---- Rendering ---------------------------------------------------------------
def footer(tool, cfg):
    if tool == "claude":
        return ("Personal overrides: `~/.claude/CLAUDE.local.md` (seeded from "
                "`config/user.yaml`) wins over this block. Reviewer roles: `/code-review`.")
    if tool == "codex":
        return "Codex: `.codex/config.toml`; workflows: `.agents/skills/`."
    if tool == "gemini":
        return ("Autonomy is a UI toggle: Settings -> Terminal Execution Policy. "
                "Personal overrides live in your user GEMINI.md.")
    if tool == "cursor":
        return ("Cursor rule (repo-scoped). Generated by coder-ai-os — do not hand-edit; "
                "edit config/*.yaml and recompile.")
    if tool == "copilot":
        return ("GitHub Copilot instructions (repo-scoped). Generated by coder-ai-os — "
                "do not hand-edit; edit config/*.yaml and recompile.")
    return ""


def render(cfg, tool):
    ident, saf = cfg["identity"], cfg["safety"]
    wf, tok, usr = cfg["workflow"], cfg["tokens"], cfg["user"]
    orient = wf.get("orient", {})
    clarify = wf.get("clarify", {})
    L = []
    L.append("**Personal defaults — generated by `coder-ai-os`; edit config and run "
             "`bin/compile`. Repository instructions win.**")
    L.append("")
    L.append("Read `.coder-ai/local/INSTRUCTIONS.md` when present; repo instructions win.")
    L.append("")
    # 1. Guardrails first (negative constraints)
    L.append("## Never — guardrails (hard constraints, always hold)")
    for n in saf.get("never", []):
        L.append("- " + n)
    L.append("")
    # 2. Autonomy
    L.append("## Autonomy — act, don't just explain")
    L.append(ident.get("persona", "") + " Understand intent -> trace current code -> "
             "smallest complete change -> run lint/typecheck/tests -> report the diff. "
             "Never claim success without an observed validation run. A pure question = "
             "explain first.")
    L.append("")
    # 2c. Delivery — the POSITIVE half of the git guardrail. Without this section the
    #     agent reads only "never run git" and reports that git is entirely off-limits,
    #     never discovering that a project can declare a workflow it is allowed to use.
    dl = wf.get("delivery") or {}
    if dl:
        command = dl.get("command", "coder-ai ship")
        declaration = dl.get("declaration", ".coder-ai/delivery.yaml")
        L.append("## Delivery — you CAN ship")
        L.append("Ordinary git is yours; delivery is not improvised: when `" + declaration
                 + "` exists and is enabled here, finish with `" + command + "` — it "
                 "branches off the base, commits, pushes only that branch, opens the PR. "
                 + str(dl.get("rule", "")).strip().capitalize() + ". Preview with "
                 "`--dry-run`; if none is declared, say so and use the handoff below.")
        if dl.get("evidence"):
            L.append("Evidence: " + str(dl["evidence"]).strip() + ".")
        L.append("")
    # 2d. Commit handoff — what to OUTPUT on a commit request when no workflow is
    #     declared; execution stays forbidden, so this renders the positive half.
    ch = wf.get("commit_handoff") or {}
    if ch:
        L.append("## Commit handoff — no workflow declared")
        L.append("Asked to commit: split the diff into `git add <files>` + `git commit -m "
                 "\"...\"` steps in apply order, <=" + str(ch.get("max_files_per_commit", 3))
                 + " related files each. Messages: one-line, "
                 "human-toned, Conventional prefix (fix/feat/docs/test/refactor/chore)" +
                 ("; add the package scope in monorepos, e.g. `fix(api): ...`"
                  if ch.get("monorepo_scope") else "") +
                 ". Never mix unrelated concerns or generated artifacts into one commit." +
                 (" No AI trailer, co-author, email, or tool name in it."
                  if ch.get("no_attribution") else ""))
        L.append("")
    # 2b. Optional profile line — rendered ONLY when languages/style are set, so it
    #     costs zero tokens by default. Experience is included only when shown.
    langs = usr.get("languages") or []
    if isinstance(langs, str):  # defensive: a scalar slipped through
        langs = [langs] if langs else []
    coding = usr.get("coding") or {}
    coding_bits = [str(v) for v in coding.values() if v] if isinstance(coding, dict) else []
    if langs or usr.get("code_style") or coding_bits:
        prof = ["experience: " + str(usr.get("experience", "?"))]
        if langs:
            prof.append("langs: " + ", ".join(str(x) for x in langs))
        if usr.get("code_style"):
            prof.append("style: " + str(usr.get("code_style")))
        if coding_bits:
            prof.append("coding: " + ", ".join(coding_bits))
        L.append("## Profile")
        L.append(" · ".join(prof))
        L.append("")
    # 3. Clarify by exception
    if clarify.get("mode") == "by-exception":
        L.append("## Clarify by exception")
        L.append("Triage first (goal · problem · constraints · area · done-criteria). "
                 "Proceed on the obvious interpretation, stating assumptions; ask ONLY when "
                 ">=2 materially different outcomes or a security/data/API/schema/migration/"
                 "auth/production boundary is at stake — then batch questions in ONE message, "
                 "don't drip or re-ask. Never ask what code inspection can answer.")
        L.append("")
    # 4. Orient
    if orient.get("strategy") == "query-first":
        L.append("## Orient before editing — token discipline")
        L.append("Query, don't full-scan; escalate: " + orient.get("levels", "") +
                 ". L1: `rg -w '<name>' .ai/symbols/` — one row answers; NEVER read a map "
                 "whole (units in `" +
                 orient.get("snapshot", "") + "`); " + orient.get("index", "") +
                 ". After edits: `.coder-ai/scripts/update-ai-context.sh --changed <dir>` shows "
                 "changes; task done: `--refresh`.")
        L.append("")
    # 4c+5. Load ladder — ONE consolidated on-demand list (floor + memory + navigator +
    #       standards + protocol + skills). Separate pointer systems invited defensive
    #       pre-loading; one ladder with explicit triggers costs less and removes doubt.
    ctx = cfg.get("context", {}) or {}
    skl = cfg.get("skills", {}) or {}
    mem = cfg.get("memory", {}) or {}
    enabled = skl.get("enabled") or []
    if enabled or ctx or mem or wf.get("planning"):
        L.append("## Load ladder — each step on its trigger only, never defensively")
        parts = ["Floor (every tier): state intent -> read before editing -> verify "
                 "claimed behavior -> contradicting evidence = reclassify."]
        if mem.get("location"):
            parts.append("Resume work: `" + str(mem.get("resume", ".ai/memory/CURRENT.md")) +
                         "` (history: query `INDEX.md`).")
        nav = str(mem.get("navigator") or "")
        if nav:
            parts.append("Unfamiliar repo: `" + nav + "`.")
        parts.append("Before coding: `.ai/standards.md` if present.")
        if wf.get("planning"):
            parts.append("Non-trivial work: classify in `" + str(wf.get("protocol_file")) +
                         "` + load only the matching skill; feature/epic phases: "
                         "`.coder-ai/PROTOCOL_PHASES.md`.")
        parts.append("`project-tasks` only on explicit request.")
        L.append(" ".join(parts))
        L.append("")
    # 6. Reply format — pick the skeleton for the chosen format (falls back to a flat
    #    reply_skeleton for backward compatibility). Format is behavioral: `minimal`
    #    genuinely shrinks replies.
    fmt = str(tok.get("reply_format", "flow-graph"))
    skeletons = tok.get("reply_skeletons", {}) or {}
    skeleton = skeletons.get(fmt) or tok.get("reply_skeleton") or []
    verb = str(usr.get("verbosity"))
    narrate = ""
    if verb in ("medium", "high"):
        narrate = " - intent first; phase updates"
    L.append("## Reply format — " + fmt + ", <=" + str(tok.get("max_tokens")) +
             " tokens (verbosity: " + verb + narrate + ")")
    L.append("```")
    for line in skeleton:
        L.append(line)
    L.append("```")
    if tok.get("final_review"):
        L.append("End-of-task: full goal review in this format, uncapped.")
    if usr.get("language") == "match-user":
        L.append("Reply in the language of the latest message.")
    elif usr.get("language") == "english":
        L.append("English unless explicitly requested otherwise.")
    L.append("")
    L.append(footer(tool, cfg))
    body = "\n".join(L).rstrip() + "\n"
    if tool == "cursor":  # .mdc requires YAML frontmatter as the very first thing
        body = ("---\ndescription: coder-ai-os defaults (generated)\n"
                "alwaysApply: true\n---\n\n") + body
    return body


# ---- Commands ----------------------------------------------------------------
def compile_all(cfg):
    return {fname: render(cfg, tool) for fname, tool, _scope in TOOLS}


def _write(path, content):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(content)


def _skill_parts(sid):
    """Return portable Agent Skill metadata, frontmatter, and body; None if malformed."""
    src = os.path.join(ROOT, "skills", str(sid), "SKILL.md")
    if not os.path.exists(src):
        return None
    with open(src, encoding="utf-8") as f:
        lines = f.read().splitlines()
    if not lines or lines[0].strip() != "---":
        return None
    try:
        end = next(i for i in range(1, len(lines)) if lines[i].strip() == "---")
    except StopIteration:
        return None
    meta, _ = _parse(lines[1:end], 0, 0)
    if not isinstance(meta, dict):
        return None
    front = "\n".join(lines[:end + 1]) + "\n"
    body = "\n".join(lines[end + 1:]).lstrip("\n") + "\n"
    return meta, front, body


def _skill_body(cfg, sid):
    """Generated SKILL.md with canonical frontmatter plus our ownership marker."""
    parts = _skill_parts(sid)
    if parts is None:
        return None
    _, front, body = parts
    return front + GEN_MD + "\n\n" + body


def _emit_skill_dir(dest, sid, content, include_openai=False):
    """Copy a complete skill bundle, then stamp its generated SKILL.md."""
    src = os.path.join(ROOT, "skills", str(sid))
    if os.path.exists(dest):
        shutil.rmtree(dest)
    shutil.copytree(src, dest)
    if not include_openai:
        shutil.rmtree(os.path.join(dest, "agents"), ignore_errors=True)
    _write(os.path.join(dest, "SKILL.md"), content)


def skill_problems(cfg):
    """Validate the portable Agent Skills core shared by Claude and Codex."""
    issues = []
    budget = int((cfg.get("context", {}) or {}).get("budgets_tokens", {}).get("skill_summary", 80) or 80)
    for sid in (cfg.get("skills", {}) or {}).get("enabled", []) or []:
        parts = _skill_parts(sid)
        if parts is None:
            issues.append("skill '%s' is missing or has invalid YAML frontmatter" % sid)
            continue
        meta, _, body = parts
        name, desc = str(meta.get("name", "")), str(meta.get("description", ""))
        if not re.fullmatch(r"[a-z0-9-]{1,64}", name) or name != str(sid):
            issues.append("skill '%s' name must match its lowercase hyphenated directory" % sid)
        if not desc:
            issues.append("skill '%s' needs a trigger description" % sid)
        elif len(desc.encode("utf-8")) > budget * 4:
            issues.append("skill '%s' description exceeds ~%d-token budget" % (sid, budget))
        extra = sorted(set(meta) - {"name", "description"})
        if extra:
            issues.append("skill '%s' has non-portable frontmatter: %s" % (sid, ", ".join(extra)))
        if len(body.splitlines()) > 500:
            issues.append("skill '%s' body exceeds 500 lines; move detail into references/" % sid)
    return issues


def emit_skills(cfg):
    """Emit each enabled skill into Claude and Codex skill trees (same SKILL.md format).
    install.sh drops these into ~/.claude/skills and ~/.agents/skills so they load in any repo."""
    n = 0
    for sid in (cfg.get("skills", {}) or {}).get("enabled", []) or []:
        content = _skill_body(cfg, sid)
        if content is None:
            continue
        for tool in ("claude", "codex"):
            dest = os.path.join(BUILD_DIR, "skills", tool, str(sid))
            _emit_skill_dir(dest, sid, content, include_openai=(tool == "codex"))
        n += 1
    return n


def emit_project(cfg):
    """Generate repo-scoped harness artifacts into build/project/ for install.sh --project."""
    base = os.path.join(BUILD_DIR, "project", ".claude")
    codex_agents = os.path.join(BUILD_DIR, "project", ".codex", "agents")
    n = {"commands": 0, "agents": 0, "skills": 0, "hooks": 0, "mcp": 0}
    navigator = os.path.join(ROOT, "templates", "PROJECT_NAVIGATOR.md")
    with open(navigator, encoding="utf-8") as f:
        _write(os.path.join(BUILD_DIR, "project", "PROJECT_NAVIGATOR.md"), GEN_MD + "\n" + f.read())
    codex_rules = os.path.join(ROOT, "codex", "rules", "coder-ai-os.rules")
    if os.path.exists(codex_rules):
        with open(codex_rules, encoding="utf-8") as f:
            _write(os.path.join(BUILD_DIR, "project", ".codex", "rules", "coder-ai-os.rules"),
                   "# coder-ai-os:generated\n" + f.read())
    for name, c in ((cfg.get("commands", {}) or {}).get("commands", {}) or {}).items():
        _write(os.path.join(base, "commands", name + ".md"),
               "---\ndescription: %s\n---\n%s\n\n%s\n" % (c.get("description", ""), GEN_MD, c.get("body", "")))
        n["commands"] += 1
    for name, a in ((cfg.get("subagents", {}) or {}).get("subagents", {}) or {}).items():
        _write(os.path.join(base, "agents", name + ".md"),
               "---\nname: %s\ndescription: %s\n---\n%s\n\n%s\n" % (name, a.get("description", ""), GEN_MD, a.get("prompt", "")))
        prompt = str(a.get("prompt", "")).replace('"""', '\\"""')
        # No sandbox_mode pin: Codex picks its own sandbox (a pinned read-only sandbox
        # dies on machines where bwrap is blocked); the read-only role contract lives in
        # the instructions instead.
        _write(os.path.join(codex_agents, name + ".toml"),
               "# coder-ai-os:generated\nname = %s\ndescription = %s\n"
               "developer_instructions = \"\"\"\n%s\n\"\"\"\n"
               % (json.dumps(str(name)), json.dumps(str(a.get("description", ""))), prompt))
        n["agents"] += 1
    for sid in (cfg.get("skills", {}) or {}).get("enabled", []) or []:
        content = _skill_body(cfg, sid)
        if content is not None:
            _emit_skill_dir(os.path.join(base, "skills", str(sid)), sid, content)
            n["skills"] += 1
    hks = (cfg.get("hooks", {}) or {}).get("hooks", {}) or {}
    if hks:
        lines = [GEN_MD, "# Suggested agent hooks — fill in real commands; not auto-run.", ""]
        for hid, h in hks.items():
            lines.append("- %s [%s]: %s" % (hid, h.get("event", ""), h.get("action", "")))
        _write(os.path.join(base, "HOOKS.md"), "\n".join(lines) + "\n")
        n["hooks"] = len(hks)
        # Executable hooks must be bounded and fail-open. Completion quality is owned by the
        # protocol/skills, not by a global Stop prompt: Stop fires after every Claude response,
        # including conversations and human/external handoffs.
        executable = [h for hid, h in hks.items()
                      if "stop" in str(h.get("event", "")).lower()
                      or hid == "val_after_ui_change" or h.get("command")]
        if executable:
            settings = {"hooks": {}}
            for hook in executable:
                event = str(hook.get("event", ""))
                command = str(hook.get("command", ""))
                if command:
                    candidate = {"hooks": [{"type": "command", "command": command}]}
                    if hook.get("matcher"):
                        candidate["matcher"] = str(hook["matcher"])
                    settings["hooks"].setdefault(event, []).append(candidate)
                    continue
                prompt = str(hook.get("action", ""))
                candidate = {"hooks": [{"type": "prompt", "prompt": prompt}]}
                if hook.get("matcher"):
                    candidate["matcher"] = str(hook["matcher"])
                settings["hooks"].setdefault(event, []).append(candidate)
            _write(os.path.join(BUILD_DIR, "project", "settings.hooks.json"),
                   json.dumps(settings, indent=2) + "\n")
    servers = (cfg.get("mcp", {}) or {}).get("servers", {}) or {}
    if servers:
        lines = [GEN_MD, "# MCP servers — `install.sh --with-codegraph` wires codegraph; others register manually.", ""]
        for sid, s in servers.items():
            args = " ".join(str(x) for x in (s.get("args", []) or []))
            lines.append("- %s: `%s %s` -> %s" % (sid, s.get("command", ""), args, s.get("targets", [])))
        _write(os.path.join(BUILD_DIR, "project", "MCP.md"), "\n".join(lines) + "\n")
        n["mcp"] = len(servers)
    return n


def emit_commands(cfg):
    """Compile each command in config/commands.yaml into EVERY tool's native format, so the
    same command triggers on supported repository command surfaces.
      Claude  -> build/commands/claude/<name>.md   (frontmatter + body)
      Gemini  -> build/commands/gemini/<name>.toml  (description + prompt)
      Cursor  -> build/commands/cursor/<name>.md
    """
    cmds = (cfg.get("commands", {}) or {}).get("commands", {}) or {}
    for name, c in cmds.items():
        desc, body = c.get("description", ""), c.get("body", "")
        _write(os.path.join(BUILD_DIR, "commands", "claude", name + ".md"),
               "---\ndescription: %s\n---\n%s\n\n%s\n" % (desc, GEN_MD, body))
        tprompt = body.replace("\\", "\\\\").replace('"""', '\\"\\"\\"')
        _write(os.path.join(BUILD_DIR, "commands", "gemini", name + ".toml"),
               '# coder-ai-os:generated\ndescription = "%s"\nprompt = """\n%s\n"""\n'
               % (desc.replace('"', '\\"'), tprompt))
        _write(os.path.join(BUILD_DIR, "commands", "cursor", name + ".md"),
               "# %s\n%s\n\n%s\n\n%s\n" % (name, GEN_MD, desc, body))
    return len(cmds)


def _bare(value):
    """Values may carry a trailing comment when PyYAML is unavailable."""
    if isinstance(value, str):
        return value.split("#", 1)[0].strip()
    return value


def pr_automation_problems(cfg):
    """PR automation's config is a boundary: reject anything that widens it."""
    pr = cfg.get("pr_automation", {}) or {}
    if not pr:
        return []
    probs = []
    profiles = pr.get("execution_profiles", {}) or {}
    normal, elevated = profiles.get("normal", {}) or {}, profiles.get("pr_automation", {}) or {}
    if _bare(normal.get("git_write")) not in (False, None):
        probs.append("pr_automation.execution_profiles.normal.git_write must stay false "
                     "(PR automation may never elevate ordinary sessions)")
    if _bare(elevated.get("git_write")) not in ("scoped", None):
        probs.append("pr_automation.execution_profiles.pr_automation.git_write must be "
                     "'scoped' (unscoped git write is not offered)")
    for name, profile in (("normal", normal), ("pr_automation", elevated)):
        for key in ("deploy", "secrets"):
            if _bare(profile.get(key)) not in (False, None):
                probs.append("pr_automation.execution_profiles.%s.%s must stay false"
                             % (name, key))
    if _bare((pr.get("commit", {}) or {}).get("trailers")) not in (False, None):
        probs.append("pr_automation.commit.trailers must stay false "
                     "(Git history carries no AI metadata)")
    return probs


def config_problems(cfg):
    probs = skill_problems(cfg)
    v = cfg.get("user", {}).get("verbosity")
    if str(v) not in ("low", "medium", "high"):
        probs.append("user.verbosity %r is not one of low|medium|high" % (v,))
    probs += pr_automation_problems(cfg)
    return probs


def cmd_build(cfg):
    issues = config_problems(cfg)
    if issues:
        for issue in issues:
            print("  FAIL: " + issue, file=sys.stderr)
        return 1
    os.makedirs(BUILD_DIR, exist_ok=True)
    for fname, body in compile_all(cfg).items():
        with open(os.path.join(BUILD_DIR, fname), "w", encoding="utf-8") as f:
            f.write(body)
        # Print the directory actually written: --project and --out redirect BUILD_DIR,
        # and a hard-coded "build/" hid a compile that landed somewhere else.
        where = os.path.relpath(os.path.join(BUILD_DIR, fname), ROOT)
        print("  compiled -> %s (%d bytes)" % (where, len(body.encode("utf-8"))))
    n = emit_project(cfg)
    nc = emit_commands(cfg)
    ns = emit_skills(cfg)
    print("  project artifacts -> build/project/  (%d commands, %d agents, %d skills, %d hooks, %d mcp)"
          % (n["commands"], n["agents"], n["skills"], n["hooks"], n["mcp"]))
    print("  per-tool commands -> build/commands/{claude,gemini,cursor}/  (%d each)" % nc)
    print("  cross-tool skills -> build/skills/{claude,codex}/  (%d each)" % ns)
    print("done. install.sh injects global files; --project drops repo-scoped artifacts.")
    return 0


def generated_tree_drift(cfg):
    """Return generated build paths whose presence or content differs from a clean compile."""
    global BUILD_DIR
    actual_root, previous = BUILD_DIR, BUILD_DIR
    with tempfile.TemporaryDirectory(prefix="coder-ai-os-build-") as expected_root:
        try:
            BUILD_DIR = expected_root
            for fname, body in compile_all(cfg).items():
                _write(os.path.join(BUILD_DIR, fname), body)
            emit_project(cfg)
            emit_commands(cfg)
            emit_skills(cfg)
        finally:
            BUILD_DIR = previous

        def files(root):
            found = {}
            if not os.path.isdir(root):
                return found
            for base, dirs, names in os.walk(root):
                dirs[:] = sorted(d for d in dirs if d != "__pycache__")
                for name in sorted(names):
                    path = os.path.join(base, name)
                    rel = os.path.relpath(path, root)
                    if os.path.islink(path):
                        found[rel] = b"<symlink>"
                        continue
                    with open(path, "rb") as f:
                        found[rel] = f.read()
            return found

        expected, actual = files(expected_root), files(actual_root)
        return sorted(path for path in set(expected) | set(actual)
                      if expected.get(path) != actual.get(path))


def cmd_check(cfg, fail_on_drift=True):
    issues = config_problems(cfg)
    if issues:
        for issue in issues:
            print("  FAIL: " + issue)
        return 1
    limit = int(cfg["tokens"].get("budget", {}).get("global_file_max_kb", 3)) * 1024
    codex_cap = int(cfg["tokens"].get("budget", {}).get("codex_total_max_kib", 32)) * 1024
    outputs = compile_all(cfg)
    ref_cfg = load_config(use_machine_overlay=False)  # committed build/ is defaults-only
    ref = compile_all(ref_cfg)
    over = False
    drift = False
    print("Agent Compiler — status")
    for fname, body in outputs.items():
        n = len(body.encode("utf-8"))
        status = "OK" if n <= limit else "OVER BUDGET"
        if n > limit:
            over = True
        print("  %-10s %5d B  %-11s (global<=%dB, %d B headroom to Codex 32KiB)"
              % (fname, n, status, limit, codex_cap - n))
        built = os.path.join(BUILD_DIR, fname)
        if not os.path.exists(built) or open(built, encoding="utf-8").read() != ref.get(fname, body):
            drift = True
    tree_drift = generated_tree_drift(ref_cfg)
    drift = drift or bool(tree_drift)
    if drift:
        print("  DRIFT: build/ is missing or stale — run `bin/compile`.")
        if tree_drift:
            print("  generated tree differences: " + ", ".join(tree_drift[:8]) +
                  (" ..." if len(tree_drift) > 8 else ""))
    if over:
        print("  FAIL: at least one output exceeds the global budget. Trim config/*.yaml.")
        return 1
    print("  all outputs within budget." + ("" if not drift else " (but build/ is stale)"))
    # Drift is a build-freshness notice, not a config error: only --check enforces it.
    return 1 if (drift and fail_on_drift) else 0


def cmd_validate():
    """Validate a (possibly AI-written) config/local.yaml overlay, then budget-check."""
    local_path = os.path.join(CONFIG_DIR, "local.yaml")
    print("Agent Compiler — validate overlay")
    if not os.path.exists(local_path):
        print("  no config/local.yaml — using committed defaults. OK.")
        return cmd_check(load_config())
    local = load_yaml(local_path) or {}
    allowed = {"user", "tokens", "workflow"}
    problems = 0
    if "safety" in local:
        print("  WARN: `safety:` in overlay is ignored — guardrails are non-negotiable.")
    for k in local:
        if k not in allowed and k != "safety":
            print("  WARN: unknown overlay key `%s` (allowed: %s)" % (k, ", ".join(sorted(allowed))))
            problems += 1
    print("  overlay keys: " + ", ".join(local.keys()))
    # Validation judges keys + budget, not build/ freshness (install recompiles).
    rc = cmd_check(load_config(), fail_on_drift=False)
    return rc or (1 if problems else 0)


def cmd_doctor():
    """Health report: budget, drift, config conflicts, duplicate rules — the Audit engine."""
    cfg = load_config()
    tok, usr, saf = cfg["tokens"], cfg["user"], cfg["safety"]
    limit = int(tok.get("budget", {}).get("global_file_max_kb", 3)) * 1024
    codex_cap = int(tok.get("budget", {}).get("codex_total_max_kib", 32)) * 1024
    outputs = compile_all(cfg)
    ref_cfg = load_config(use_machine_overlay=False)  # committed build/ is defaults-only
    ref = compile_all(ref_cfg)

    problems, conflicts, warns = [], [], []
    problems.extend(config_problems(cfg))
    largest, drift = 0, False
    for fname, body in outputs.items():
        n = len(body.encode("utf-8"))
        largest = max(largest, n)
        if n > limit:
            problems.append("%s over budget (%d > %d B)" % (fname, n, limit))
        built = os.path.join(BUILD_DIR, fname)
        if not os.path.exists(built) or open(built, encoding="utf-8").read() != ref.get(fname, body):
            drift = True
    tree_drift = generated_tree_drift(ref_cfg)
    drift = drift or bool(tree_drift)

    # conflicts
    if "max_tokens" in usr and usr.get("max_tokens") != tok.get("max_tokens"):
        conflicts.append("user.max_tokens (%s) != tokens.max_tokens (%s)"
                         % (usr.get("max_tokens"), tok.get("max_tokens")))
    fmt = tok.get("reply_format")
    if fmt not in (tok.get("reply_skeletons", {}) or {}) and not tok.get("reply_skeleton"):
        problems.append("reply_format '%s' has no matching skeleton" % fmt)
    langs = usr.get("languages")
    if langs is not None and not isinstance(langs, list):
        warns.append("user.languages is not a list (%r)" % (langs,))

    # overlay
    overlay = "none"
    local_path = os.path.join(CONFIG_DIR, "local.yaml")
    if os.path.exists(local_path):
        local = load_yaml(local_path) or {}
        overlay = ", ".join(local.keys()) or "empty"
        if "safety" in local:
            warns.append("overlay has `safety:` (ignored — guardrails are fixed)")
        for k in local:
            if k not in ("user", "tokens", "workflow", "safety"):
                warns.append("overlay unknown key `%s`" % k)

    # duplicated rules
    seen, dups = set(), 0
    for n in saf.get("never", []) or []:
        k = n.strip().lower()
        dups += 1 if k in seen else 0
        seen.add(k)

    # skills: canonical directories not selected in config are reported as unused
    skl = cfg.get("skills", {}) or {}
    enabled = skl.get("enabled", []) or []
    defined = [s for s in os.listdir(os.path.join(ROOT, "skills")) if os.path.isdir(os.path.join(ROOT, "skills", s))]
    unused = [s for s in defined if s not in enabled]

    # context: estimate tokens (~bytes/4) vs the advisory global-instruction target
    ctx_budget = int((cfg.get("context", {}) or {}).get("budgets_tokens", {}).get("global_instruction", 0) or 0)
    est_tokens = largest // 4
    ctx_note = ""
    if ctx_budget:
        ctx_note = "~%d tok vs %d target (%s)" % (est_tokens, ctx_budget,
                                                  "HIGH" if est_tokens > ctx_budget else "ok")

    counts = "%d commands · %d subagents · %d hooks · %d mcp" % (
        len((cfg.get("commands", {}) or {}).get("commands", {}) or {}),
        len((cfg.get("subagents", {}) or {}).get("subagents", {}) or {}),
        len((cfg.get("hooks", {}) or {}).get("hooks", {}) or {}),
        len((cfg.get("mcp", {}) or {}).get("servers", {}) or {}))

    fail = bool(problems)
    health = "FAIL" if fail else ("WARN" if (conflicts or warns) else "PASS")
    print("coder-ai-os doctor")
    print("  configuration     %s" % ("FAIL" if fail else "PASS"))
    print("  token budget      %d B / %d B  (largest output, %d B headroom to Codex 32KiB)"
          % (largest, limit, codex_cap - largest))
    print("  instruction size  %s" % ("OVER" if largest > limit else "GOOD"))
    if ctx_note:
        print("  context health    %s" % ctx_note)
    print("  conflicts         %d" % len(conflicts))
    print("  duplicated rules  %d" % dups)
    print("  drift             %s" % ("STALE — run bin/compile" if drift else "clean"))
    print("  overlay           %s" % overlay)
    print("  skills            %d enabled, %d unused" % (len(enabled), len(unused)))
    print("  harness           %s" % counts)
    for c in conflicts:
        print("    conflict: " + c)
    for p in problems:
        print("    FAIL: " + p)
    for w in warns:
        print("    warn: " + w)
    print("  --- health: %s" % health)
    return 1 if fail else 0


def cmd_print_mcp():
    """Emit config/mcp.yaml servers tab-delimited for install.sh to register generically:
    name<TAB>command<TAB>space-joined-args<TAB>comma-targets<TAB>installer"""
    servers = (load_config().get("mcp", {}) or {}).get("servers", {}) or {}
    for name, s in servers.items():
        args = " ".join(str(x) for x in (s.get("args", []) or []))
        targets = ",".join(str(t) for t in (s.get("targets", []) or []))
        print("\t".join([str(name), str(s.get("command", "")), args, targets,
                         str(s.get("installer", "") or "")]))
    return 0


def main(argv):
    global BUILD_DIR
    if "--out" in argv:
        # Write the build tree to a custom directory instead of the committed build/.
        # Used at install time (with --overlay) so personalized output never lands in
        # the committed artifact.
        i = argv.index("--out")
        if i + 1 >= len(argv):
            print("error: --out requires a directory argument", file=sys.stderr)
            return 2
        BUILD_DIR = os.path.abspath(argv[i + 1])
    if "--print-mcp" in argv:
        return cmd_print_mcp()
    if "--project" in argv:
        # Compile THIS repo: merge its .coder-ai/project.yaml and write to .coder-ai/generated/.
        i = argv.index("--project")
        pdir = os.path.abspath(argv[i + 1]) if i + 1 < len(argv) else os.getcwd()
        BUILD_DIR = os.path.join(pdir, ".coder-ai", "generated")
        cfg = load_config(repo_overlay=os.path.join(pdir, ".coder-ai", "project.yaml"))
        return cmd_build(cfg)
    if "--doctor" in argv:
        return cmd_doctor()
    if "--validate" in argv:
        return cmd_validate()
    if "--overlay" in argv:
        # Install-time: apply this machine's config/local.yaml so the user's own
        # ~/.claude gets personalized. Pair with --out <tmp> so the committed build/
        # is never overwritten with per-machine content.
        return cmd_build(load_config(use_machine_overlay=True))
    if "--check" in argv:
        return cmd_check(load_config())
    # Default: render the COMMITTED, shared build/ from defaults only (no machine overlay).
    return cmd_build(load_config(use_machine_overlay=False))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
