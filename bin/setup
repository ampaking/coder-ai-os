#!/usr/bin/env bash
# coder-ai-os wizard — ask the engineer's intent, write a per-machine preference
# overlay (config/local.yaml, gitignored), then compile + install. Safety guardrails
# (.env / git-write / sudo / unrelated-refactor) are ALWAYS on and never asked.
#
#   bin/setup              interactive
#   bin/setup --defaults   accept every default, no prompts (CI-friendly)
set -euo pipefail
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LOCAL="$REPO_DIR/config/local.yaml"

DEFAULTS=0
APPLY_FLAGS=()
for a in "$@"; do
  case "$a" in
    --defaults) DEFAULTS=1 ;;
    -h|--help) echo "usage: bin/setup [--defaults]"; exit 0 ;;
    *) echo "unknown arg: $a" >&2; exit 2 ;;
  esac
done

# ask_choice <var> <prompt> <default> <opt1> <opt2> ...  — validates against options
ask_choice(){
  local __var="$1" prompt="$2" def="$3"; shift 3
  local opts=("$@") ans
  if [ "$DEFAULTS" = 1 ]; then printf -v "$__var" '%s' "$def"; return; fi
  while true; do
    read -r -p "$prompt ($(IFS='/'; echo "${opts[*]}")) [$def]: " ans || ans=""
    ans="${ans:-$def}"
    local o; for o in "${opts[@]}"; do [ "$ans" = "$o" ] && { printf -v "$__var" '%s' "$ans"; return; }; done
    echo "  please choose one of: ${opts[*]}"
  done
}
ask_value(){  # <var> <prompt> <default>
  local __var="$1" prompt="$2" def="$3" ans
  if [ "$DEFAULTS" = 1 ]; then printf -v "$__var" '%s' "$def"; return; fi
  read -r -p "$prompt [$def]: " ans || ans=""
  printf -v "$__var" '%s' "${ans:-$def}"
}
ask_yn(){  # <var> <prompt> <default y|n>
  local __var="$1" prompt="$2" def="$3" ans
  if [ "$DEFAULTS" = 1 ]; then printf -v "$__var" '%s' "$def"; return; fi
  read -r -p "$prompt [y/n, default $def]: " ans || ans=""
  ans="${ans:-$def}"; case "$ans" in y|Y|yes) ans=y ;; *) ans=n ;; esac
  printf -v "$__var" '%s' "$ans"
}

cat <<'EOF'
┌────────────────────────────────────────────────┐
│  coder-ai-os · setup                            │
└────────────────────────────────────────────────┘
This sets how every AI coding agent behaves — for you.
Press Enter to accept the [default] on each question; it takes about a minute.
Safety guardrails are always on (no .env reads · no git push · no sudo) — never asked.
EOF
echo
# Detect which AI CLIs are on this machine — feels smart, and reassures beginners.
_found=""; for _t in claude codex gemini cursor; do command -v "$_t" >/dev/null 2>&1 && _found="$_found $_t"; done
if [ -n "$_found" ]; then echo "Detected AI tools:$_found  (coder-ai-os will configure these + any you add later)"
else echo "No AI CLIs detected yet — no problem; coder-ai-os configures each for when you install it."; fi
echo

echo "1/3 · About you"
ask_choice EXPERIENCE "  How experienced are you" senior senior junior
ask_choice LANGUAGE   "  Reply language"          match-user match-user english
echo "2/3 · How replies should look"
ask_choice VERBOSITY  "  Verbosity"     medium low medium high
ask_choice REPLYFMT   "  Reply format"  flow-graph flow-graph prose minimal
ask_value  MAXTOK     "  Max reply tokens (the end-of-task review is exempt)" 500
echo "3/3 · How much process"
ask_yn     STRICT     "  Strict mode (more planning + architecture review + ask before big scans)?" n
ask_yn     CODEXDEF   "  Make Codex autonomous the default?" n
ask_yn     CODEGRAPH  "  Add the CodeGraph code index (needs npm)?" n

# strict mode → workflow toggles
ARCHREVIEW=false; ASKSCAN=true
[ "$STRICT" = y ] && ARCHREVIEW=true

mkdir -p "$REPO_DIR/config"
cat > "$LOCAL" <<EOF
# Per-machine preference overlay — generated by bin/setup. Gitignored.
# Overrides config/*.yaml defaults; safety guardrails are NOT overridable here.
user:
  experience: $EXPERIENCE
  verbosity: $VERBOSITY
  language: $LANGUAGE
  max_tokens: $MAXTOK
tokens:
  reply_format: $REPLYFMT
  max_tokens: $MAXTOK
workflow:
  architecture_review: $ARCHREVIEW
  clarify:
    ask_before_large_scan: $ASKSCAN
EOF

echo
echo "Review — your profile (saved to config/local.yaml):"
sed 's/^/    /' "$LOCAL"
echo
ask_yn APPLYNOW "Apply this to your agents now?" y

if [ "$APPLYNOW" = y ]; then
  [ "$CODEXDEF" = y ]  && APPLY_FLAGS+=(--codex-safety-defaults)
  [ "$CODEGRAPH" = y ] && APPLY_FLAGS+=(--with-codegraph)
  echo; "$REPO_DIR/install.sh" "${APPLY_FLAGS[@]}"
  echo; echo "✓ Done — every agent now works your way. Check it: coder-ai verify"
else
  echo "Saved, not applied. Apply anytime with:  ./install.sh"
fi
