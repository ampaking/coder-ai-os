{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".coder-ai/scripts/val-post-edit.py"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "coder-ai-os tasks hook claude"
          }
        ]
      }
    ]
  }
}
