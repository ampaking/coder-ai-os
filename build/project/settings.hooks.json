{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".coder-ai/scripts/val-post-edit.py"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": ".coder-ai/scripts/evidence-post-tool.py"
          }
        ],
        "matcher": "Bash|Edit|Write|MultiEdit"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "coder-ai tasks hook claude"
          }
        ]
      }
    ]
  }
}
