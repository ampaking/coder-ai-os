#!/usr/bin/env bash
# The single-quoted $ expressions below are emitted into generated project files.
# shellcheck disable=SC2016
set -euo pipefail
IFS=$'\n\t'

PROJECT="${1:-.}"
PROJECT="$(cd "$PROJECT" && pwd -P)"
# The generated wrapper must reach this tool's own `val`, not a binary on PATH:
# there is one CLI on PATH now, and it is `coder-ai`.
VAL_HOME="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
STATE_DIR="$PROJECT/.coder-ai/val"
CONFIG_FILE="$STATE_DIR/config.json"
GUIDE_FILE="$STATE_DIR/SETUP.md"
RUN_FILE="$STATE_DIR/run"
IGNORE_FILE="$STATE_DIR/.gitignore"
APPS_DIR="$STATE_DIR/apps"
APPS_FILE="$STATE_DIR/apps.json"
DETECTED_KIND='none'
DETECTED_SERVE=''
DETECTED_ENV='auto'
DETECTED_PORT_FLAG='env'
DETECTION_DETAIL='No supported UI workflow was detected.'
DOLLAR='$'

fail() {
  printf 'VAL setup: %s\n' "$*" >&2
  exit 3
}

[ ! -L "$PROJECT/.coder-ai" ] || fail 'refusing symlink: .coder-ai'
[ ! -L "$STATE_DIR" ] || fail 'refusing symlink: .coder-ai/val'
[ ! -L "$PROJECT/.coder-ai/scripts" ] || fail 'refusing symlink: .coder-ai/scripts'
command -v jq >/dev/null 2>&1 || fail 'jq is required for automatic VAL project detection'

has_ui_files() {
  find "$PROJECT" \
    \( -name .git -o -name node_modules -o -name vendor -o -name .coder-ai -o -name .ai \) -prune -o \
    -type f \( -name '*.html' -o -name '*.htm' -o -name '*.jsx' -o -name '*.tsx' -o -name '*.vue' -o -name '*.svelte' -o -name '*.twig' -o -name '*.erb' -o -name '*.blade.php' \) \
    -print -quit | awk 'NF { found=1 } END { exit(found ? 0 : 1) }'
}

package_has_ui_signal() {
  local package="$1"
  [ -f "$package" ] || return 1
  jq -e '
    ((.dependencies // {}) + (.devDependencies // {})) as $d
    | any(["react","react-dom","next","vue","nuxt","svelte","@sveltejs/kit","vite","webpack","parcel","astro"][]; $d[.] != null)
      or ([.scripts[]?] | any(.[]; test("next|vite|webpack|react-scripts|vue-cli-service|nuxt|svelte|astro|parcel")))
  ' "$package" >/dev/null 2>&1
}

detect_package() {
  local package="$PROJECT/package.json" script_name manager
  [ -f "$package" ] || return 1
  has_ui_files || package_has_ui_signal "$package" || return 1
  script_name="$(jq -r 'if .scripts.dev then "dev" elif .scripts.start then "start" elif .scripts.serve then "serve" else empty end' "$package")"
  [ -n "$script_name" ] || return 2
  if [ -f "$PROJECT/pnpm-lock.yaml" ]; then manager='pnpm run'
  elif [ -f "$PROJECT/yarn.lock" ]; then manager='yarn'
  elif [ -f "$PROJECT/bun.lockb" ] || [ -f "$PROJECT/bun.lock" ]; then manager='bun run'
  else manager='npm run'; fi
  DETECTED_KIND='package-script'
  DETECTED_SERVE="$manager $script_name"
  DETECTED_ENV='node'
  DETECTION_DETAIL="Detected UI files or dependencies and package.json script '$script_name'."
}

package_script_name() {
  jq -r 'if .scripts.dev then "dev" elif .scripts.start then "start" elif .scripts.serve then "serve" else empty end' "$1"
}

package_manager() {
  if [ -f "$PROJECT/pnpm-lock.yaml" ]; then printf '%s\n' pnpm
  elif [ -f "$PROJECT/yarn.lock" ]; then printf '%s\n' yarn
  elif [ -f "$PROJECT/bun.lockb" ] || [ -f "$PROJECT/bun.lock" ]; then printf '%s\n' bun
  else printf '%s\n' npm; fi
}

app_id_for() {
  local relative="$1" id
  if [ "$relative" = . ]; then printf '%s\n' root; return; fi
  id="$(printf '%s' "$relative" | tr '/[:space:]_.' '-' | tr -cd '[:alnum:]-' | sed 's/--*/-/g; s/^-//; s/-$//')"
  [ -n "$id" ] || id=app
  printf '%s\n' "$id"
}

serve_for_package() {
  local relative="$1" script_name="$2" manager="$3"
  case "$manager" in
    pnpm) [ "$relative" = . ] && printf 'pnpm run %s\n' "$script_name" || printf 'pnpm --dir %q run %s\n' "$relative" "$script_name" ;;
    yarn) [ "$relative" = . ] && printf 'yarn %s\n' "$script_name" || printf 'yarn --cwd %q %s\n' "$relative" "$script_name" ;;
    bun) [ "$relative" = . ] && printf 'bun run %s\n' "$script_name" || printf 'bun --cwd %q run %s\n' "$relative" "$script_name" ;;
    *) [ "$relative" = . ] && printf 'npm run %s\n' "$script_name" || printf 'npm --prefix %q run %s\n' "$relative" "$script_name" ;;
  esac
}

write_app_config_once() {
  local app_id="$1" relative="$2" package="$3" serve="$4" framework="$5" app_dir config temporary watch
  app_dir="$APPS_DIR/$app_id"
  config="$app_dir/config.json"
  mkdir -p "$app_dir"
  [ -f "$config" ] && return 0
  watch='**/*.{tsx,jsx,vue,svelte,css,scss,html}'
  [ "$relative" = . ] || watch="$relative/$watch"
  temporary="$(mktemp "$app_dir/.config.XXXXXX")"
  jq -n --arg serve "$serve" --arg watch "$watch" --arg appId "$app_id" --arg root "$relative" --arg framework "$framework" \
    '{env:"node",browserMode:"auto",serve:$serve,portFlag:"env",url:"http://127.0.0.1:${PORT}",healthPath:"/",readyTimeoutMs:60000,reuseExisting:true,routes:["/"],viewports:[[375,812],[768,1024],[1440,900]],themes:["light","dark"],restartOn:["package.json","*lock*","*.config.*"],watchGlobs:[$watch],maxShots:40,container:{service:null,port:null,image:null},auth:null,fixture:{status:"required",adapter:(".coder-ai/scripts/val-fixtures/"+$appId+".mjs")},generated:{by:"coder-ai-os",detectedKind:"package-script",appId:$appId,appRoot:$root,framework:$framework}}' > "$temporary"
  mv "$temporary" "$config"
}

write_fixture_adapter_once() {
  local app_id="$1" relative="$2" framework="$3" dir file temporary
  dir="$PROJECT/.coder-ai/scripts/val-fixtures"
  file="$dir/$app_id.mjs"
  mkdir -p "$dir"
  [ -f "$file" ] && return 0
  temporary="$(mktemp "$dir/.fixture.XXXXXX")"
  {
    printf '%s\n' '#!/usr/bin/env node' '// coder-ai-os:generated-fixture-scaffold'
    printf 'const app = %s;\n' "$(jq -cn --arg id "$app_id" --arg root "$relative" --arg framework "$framework" '{id:$id,root:$root,framework:$framework}')"
    printf '%s\n' \
      'const message = [' \
      '  `VAL fixture ${app.id} (${app.framework}) is not completed.`,' \
      '  `Edit .coder-ai/scripts/val-fixtures/${app.id}.mjs to create test-only browser storage state and deterministic API route fixtures.`,' \
      '  "Never read production credentials or disable application authentication.",' \
      '].join(" ");' \
      'console.error(message);' \
      'process.exit(3);'
  } > "$temporary"
  chmod 755 "$temporary"
  mv "$temporary" "$file"
}

discover_package_apps() {
  local registry temporary manager package relative script_name app_id serve framework
  registry='[]'
  manager="$(package_manager)"
  while IFS= read -r package; do
    package_has_ui_signal "$package" || continue
    script_name="$(package_script_name "$package")"
    [ -n "$script_name" ] || continue
    relative="$(dirname "${package#"$PROJECT"/}")"
    [ "$package" != "$PROJECT/package.json" ] || relative=.
    app_id="$(app_id_for "$relative")"
    serve="$(serve_for_package "$relative" "$script_name" "$manager")"
    framework="$(jq -r '((.dependencies // {}) + (.devDependencies // {})) as $d | if $d.next then "next" elif $d.nuxt then "nuxt" elif $d.vue then "vue" elif $d["@sveltejs/kit"] then "sveltekit" elif $d.svelte then "svelte" elif $d.astro then "astro" elif $d.react then "react" else "unknown" end' "$package")"
    write_app_config_once "$app_id" "$relative" "$package" "$serve" "$framework"
    write_fixture_adapter_once "$app_id" "$relative" "$framework"
    registry="$(jq -n --argjson apps "$registry" --arg id "$app_id" --arg root "$relative" --arg config ".coder-ai/val/apps/$app_id/config.json" --arg framework "$framework" '$apps + [{id:$id,root:$root,config:$config,framework:$framework}]')"
  done < <(find "$PROJECT" \( -name .git -o -name node_modules -o -name vendor -o -name .coder-ai -o -name .ai \) -prune -o -name package.json -type f -print | LC_ALL=C sort)
  [ "$(printf '%s' "$registry" | jq 'length')" -gt 0 ] || return 0
  temporary="$(mktemp "$STATE_DIR/.apps.XXXXXX")"
  printf '%s\n' "$registry" | jq '{version:1,apps:.}' > "$temporary"
  mv "$temporary" "$APPS_FILE"
}

detect_project() {
  if { [ -f "$PROJECT/docker-compose.yml" ] || [ -f "$PROJECT/docker-compose.yaml" ] || [ -f "$PROJECT/compose.yml" ] || [ -f "$PROJECT/compose.yaml" ]; } && has_ui_files; then
    DETECTED_KIND='compose'
    DETECTED_ENV='compose'
    DETECTED_SERVE=''
    DETECTION_DETAIL='Detected Compose configuration and UI files.'
    return
  fi
  if [ -f "$PROJECT/Dockerfile" ] && has_ui_files; then
    DETECTED_KIND='docker'
    DETECTED_ENV='docker'
    DETECTED_SERVE=''
    DETECTION_DETAIL='Detected Dockerfile and UI files.'
    return
  fi
  if detect_package; then return; fi
  if [ -f "$PROJECT/manage.py" ] && has_ui_files; then
    DETECTED_KIND='django'
    DETECTED_ENV='node'
    DETECTED_SERVE="python3 manage.py runserver 127.0.0.1:${DOLLAR}PORT"
    DETECTION_DETAIL='Detected Django manage.py and UI templates.'
    return
  fi
  if [ -x "$PROJECT/bin/rails" ] && has_ui_files; then
    DETECTED_KIND='rails'
    DETECTED_ENV='node'
    DETECTED_SERVE="bin/rails server -b 127.0.0.1 -p ${DOLLAR}PORT"
    DETECTION_DETAIL='Detected Rails executable and UI templates.'
    return
  fi
  if [ -f "$PROJECT/artisan" ] && has_ui_files; then
    DETECTED_KIND='laravel'
    DETECTED_ENV='node'
    DETECTED_SERVE="php artisan serve --host=127.0.0.1 --port=${DOLLAR}PORT"
    DETECTION_DETAIL='Detected Laravel artisan and UI templates.'
    return
  fi
  if { [ -f "$PROJECT/index.html" ] || [ -f "$PROJECT/public/index.html" ]; }; then
    DETECTED_KIND='static'
    DETECTED_ENV='node'
    DETECTED_SERVE="python3 -m http.server \"${DOLLAR}PORT\" --bind 127.0.0.1"
    DETECTION_DETAIL='Detected a static HTML entry point.'
    return
  fi
}

write_config_once() {
  local temporary
  [ "$DETECTED_KIND" != none ] || return 0
  [ -f "$CONFIG_FILE" ] && return 0
  temporary="$(mktemp "$STATE_DIR/.config.XXXXXX")"
  jq -n \
    --arg env "$DETECTED_ENV" \
    --arg serve "$DETECTED_SERVE" \
    --arg portFlag "$DETECTED_PORT_FLAG" \
    --arg kind "$DETECTED_KIND" \
    '{env:$env,browserMode:"auto",serve:$serve,portFlag:$portFlag,url:"http://127.0.0.1:${PORT}",healthPath:"/",readyTimeoutMs:60000,reuseExisting:true,routes:["/"],viewports:[[375,812],[768,1024],[1440,900]],themes:["light","dark"],restartOn:["package.json","*lock*","requirements.txt","Gemfile","*.config.*",".env"],watchGlobs:["**/*.{tsx,jsx,vue,svelte,css,scss,html,twig,erb,blade.php}"],maxShots:40,container:{service:null,port:null,image:null},auth:null,generated:{by:"coder-ai-os",detectedKind:$kind}}' \
    > "$temporary"
  mv "$temporary" "$CONFIG_FILE"
}

write_guide() {
  local temporary config_status='not generated'
  if [ -f "$GUIDE_FILE" ] && ! grep -qF '<!-- coder-ai-os:generated -->' "$GUIDE_FILE"; then
    return 0
  fi
  [ -f "$CONFIG_FILE" ] && config_status="available at \`.coder-ai/val/config.json\`"
  temporary="$(mktemp "$STATE_DIR/.setup.XXXXXX")"
  {
    printf '%s\n' '<!-- coder-ai-os:generated -->' '# Visual Autonomy Loop' ''
    printf "Detection: \`%s\` — %s\n\n" "$DETECTED_KIND" "$DETECTION_DETAIL"
    printf 'Configuration: %s. Existing configuration is never overwritten by setup or sync.\n\n' "$config_status"
    printf '%s\n' "Run \`./.coder-ai/val/run doctor\` first, then \`./.coder-ai/val/run run\`. Agents should run VAL automatically after a git diff touches a configured \`watchGlobs\` UI file." ''
    printf '%s\n' 'Authenticated apps use generated test-only adapters under `.coder-ai/scripts/val-fixtures/`. Complete each adapter with local session storage and deterministic API fixtures; VAL fails closed until it is complete. In a monorepo use `./.coder-ai/val/run --app <id> ...`.' ''
    printf '%s\n' 'If detection was incomplete, edit the config with the real serve command and URL. VAL does not install project dependencies, so old Node/TypeScript and non-Node applications keep their existing toolchain.'
  } > "$temporary"
  mv "$temporary" "$GUIDE_FILE"
}

write_runner_once() {
  local temporary
  if [ -f "$RUN_FILE" ] && ! grep -qF 'coder-ai-os:generated' "$RUN_FILE" \
     && ! grep -qF 'command -v val' "$RUN_FILE" && ! grep -qF 'exec "$VAL_BIN"' "$RUN_FILE"; then
    return 0
  fi
  temporary="$(mktemp "$STATE_DIR/.run.XXXXXX")"
  {
    printf '%s\n' '#!/usr/bin/env bash' '# coder-ai-os:generated' 'set -euo pipefail' "IFS=\$'\\n\\t'" ''
    printf '%s\n' "VAL_BIN=\"\${VAL_BIN:-$VAL_HOME/val}\"" \
      '[ -x "$VAL_BIN" ] || VAL_BIN="$(command -v val 2>/dev/null || true)"' \
      '[ -n "$VAL_BIN" ] && [ -x "$VAL_BIN" ] || { echo "VAL not found; run coder-ai install" >&2; exit 3; }'
    printf '%s\n' 'ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"' 'REGISTRY="$ROOT/.coder-ai/val/apps.json"' 'APP=""'
    printf '%s\n' 'if [ "${1:-}" = --app ]; then APP="${2:-}"; [ -n "$APP" ] || { echo "VAL: --app requires an id" >&2; exit 3; }; shift 2; fi'
    printf '%s\n' 'if [ -f "$REGISTRY" ]; then' '  if [ -z "$APP" ] && [ "$(jq ".apps | length" "$REGISTRY")" -eq 1 ]; then APP="$(jq -r ".apps[0].id" "$REGISTRY")"; fi' '  if [ -z "$APP" ] && [ "$(jq ".apps | length" "$REGISTRY")" -gt 1 ]; then echo "VAL: multiple web apps detected; use --app <id>" >&2; jq -r ".apps[].id" "$REGISTRY" >&2; exit 3; fi' 'fi'
    printf '%s\n' 'if [ -n "$APP" ]; then' '  jq -e --arg id "$APP" "any(.apps[]; .id == \$id)" "$REGISTRY" >/dev/null || { echo "VAL: unknown app: $APP" >&2; exit 3; }' '  export VAL_STATE_DIR="$ROOT/.coder-ai/val/apps/$APP"' '  export VAL_CONFIG_FILE="$VAL_STATE_DIR/config.json"' 'fi'
    printf '%s\n' 'cd "$ROOT"' 'exec "$VAL_BIN" "$@"'
  } > "$temporary"
  chmod 755 "$temporary"
  mv "$temporary" "$RUN_FILE"
}

write_ignore_once() {
  [ ! -L "$IGNORE_FILE" ] || fail 'refusing symlink: .coder-ai/val/.gitignore'
  [ -f "$IGNORE_FILE" ] && return 0
  {
    printf '%s\n' 'locks/' 'runs/' 'auth.json' 'fixture.json' 'server.log' 'browser-cache/' 'apps/*/locks/' 'apps/*/runs/' 'apps/*/auth.json' 'apps/*/fixture.json' 'apps/*/server.log' 'apps/*/browser-cache/'
  } > "$IGNORE_FILE"
}

mkdir -p "$STATE_DIR" "$APPS_DIR"
detect_project
write_config_once
discover_package_apps
write_guide
write_runner_once
write_ignore_once
printf 'VAL setup: %s — %s\n' "$DETECTED_KIND" "$DETECTION_DETAIL"
