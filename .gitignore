# Per-machine preference overlay written by bin/setup — not shared.
config/local.yaml

# build/ IS committed on purpose (so install works without python3); do not ignore it.

# Python tooling junk (compiler is stdlib; these are cache dirs, never commit them)
__pycache__/
*.pyc
.mypy_cache/

# Local research scratch (downloaded third-party articles/images). Not part of the
# released tool and not ours to redistribute — never publish from this repo.
artifacts/

# coder-ai dogfoods itself: its own .ai/ workspace (snapshot, roadmap, standards,
# memory) is generated/internal — not part of the released tool. The tool still writes
# .ai/ into the repos you point it at; this ignore only affects THIS repo.
.ai/

# Project-scoped dogfood output created when coder-ai-os is run against THIS repository.
# Canonical sources live in config/, skills/, protocol/, scripts/, and build/project/.
# Keep the installed root copies local; build/ remains intentionally committed.
/.agents/
/.claude/
/.coder-ai-os-script/
/.coder-ai/*
!/.coder-ai/delivery.yaml
/.codex/
/.cursor/
/.gemini/
/.github/copilot-instructions.md
/AGENTS.md
/AI_DEV_PROTOCOL.md
/CLAUDE.md
/GEMINI.md
